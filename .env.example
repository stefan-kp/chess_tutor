# Debug Mode
# Set to 'true' to enable debug mode which shows LLM prompts and responses
# This is useful for debugging AI behavior
NEXT_PUBLIC_DEBUG=false

# LLM Provider
# "gemini" (default) - each user brings their own Google Gemini API key,
#   entered in the browser and stored in localStorage.
# "openai-compatible" - every LLM call is routed server-side to your own
#   OpenAI-compatible endpoint (Ollama, LiteLLM, LM Studio, vLLM, ...).
#   No user-facing API key is required or shown.
NEXT_PUBLIC_LLM_PROVIDER=gemini

# The following are only used when NEXT_PUBLIC_LLM_PROVIDER=openai-compatible.
# Server-side only - never bundled into the browser, so it's safe to point
# these at an internal/private endpoint.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1:8b

